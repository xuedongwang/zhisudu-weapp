/* pages/about/about.wxss */
.page { padding: 32rpx; }

.brand {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 0 24rpx;
}
.logo {
  font-size: 56rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}
.logo .em { color: var(--primary); }
.slogan { font-size: 26rpx; color: var(--sub); margin-top: 12rpx; }
.ver {
  font-size: 22rpx;
  color: var(--primary);
  background: var(--primary-weak);
  border-radius: 24rpx;
  padding: 6rpx 24rpx;
  margin-top: 24rpx;
}

.ver-card { padding: 28rpx 32rpx; margin-bottom: 24rpx; }
.vhead {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.vtag {
  font-size: 22rpx;
  font-weight: 700;
  color: #fff;
  background: var(--primary);
  border-radius: 10rpx;
  padding: 4rpx 14rpx;
}
.vtitle { font-size: 28rpx; font-weight: 600; flex: 1; }
.vdate { font-size: 22rpx; color: var(--sub); }
/* 用户还没看过的版本条目（由 about.js 的 markNew 标记）。
   与 .vtag 同色系但更轻——版本号是标识、NEW 是状态，不该互相争夺注意力 */
.vnew {
  font-size: 18rpx;
  font-weight: 700;
  color: var(--primary);
  background: var(--primary-weak);
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
  flex: none;
}
.vitems { margin-top: 18rpx; }
.vitem {
  font-size: 24rpx;
  color: #55544E;
  line-height: 1.8;
}
.vitem .dot { color: var(--primary); font-weight: 700; margin-right: 10rpx; }

.foot {
  text-align: center;
  font-size: 22rpx;
  color: #B9B6AA;
  padding: 32rpx 0;
}

/* ==================== 响应式：大屏（v2.0）====================
   依据见 app.wxss 顶部（三档口径 / 「大屏 px = 小屏 rpx ÷ 2」换算律 /
   媒体查询必须放文件末尾）。手机竖屏永不命中 → 手机端零变化。 */
@media (min-width: 600px) {
  .page { padding: 16px; }

  .brand { padding: 24px 0 12px; }
  .logo { font-size: 28px; letter-spacing: 2px; }
  .slogan { font-size: 13px; margin-top: 6px; }
  .ver {
    font-size: 11px;
    border-radius: 12px;
    padding: 3px 12px;
    margin-top: 12px;
  }

  .ver-card { padding: 14px 16px; margin-bottom: 12px; }
  .vhead { gap: 8px; }
  .vtag { font-size: 11px; border-radius: 5px; padding: 2px 7px; }
  .vtitle { font-size: 14px; }
  .vdate { font-size: 11px; }
  .vnew { font-size: 9px; border-radius: 4px; padding: 1px 5px; }
  .vitems { margin-top: 9px; }
  .vitem { font-size: 12px; }
  .vitem .dot { margin-right: 5px; }

  .foot { font-size: 11px; padding: 16px 0; }
}
