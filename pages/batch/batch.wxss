/* pages/batch/batch.wxss */
.page {
  padding: 24rpx 24rpx 0;
}

/* 说明卡 */
.tip-card {
  margin-bottom: 24rpx;
}
.tip-title {
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.5;
}
.tip-title.warn {
  color: var(--danger);
}
.tip-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--sub);
  line-height: 1.5;
}

/* 空态 */
.card.empty {
  text-align: center;
  color: var(--sub);
  padding: 60rpx 28rpx;
}
.empty-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
}

/* 勾选项 */
.pick-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.pick-item:last-child {
  border-bottom: none;
}
.picon {
  width: 88rpx;
  height: 118rpx;
  border-radius: 10rpx;
  background: var(--bg);
  overflow: hidden;
  flex: none;
}
.picon image {
  width: 100%;
  height: 100%;
}
.picon-ph {
  width: 100%;
  height: 100%;
}
.pinfo {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}
.pname {
  font-size: 28rpx;
  font-weight: 600;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.pdesc {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--sub);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.pcheck {
  flex: none;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 2rpx solid var(--line);
  margin-left: 20rpx;
  color: #fff;
  font-size: 26rpx;
  line-height: 44rpx;
  text-align: center;
}
.pick-item.on .pcheck {
  background: var(--primary);
  border-color: var(--primary);
}

/* 结果九宫格 */
.grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.cell {
  position: relative;
  width: calc((100% - 32rpx) / 3);
  aspect-ratio: 3 / 4;
  background: var(--card);
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(40, 40, 30, 0.06);
}
.cell image {
  width: 100%;
  height: 100%;
}
.cell.bad {
  background: #FBF3F3;
}
.cell-err {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
  padding: 12rpx;
  box-sizing: border-box;
}
.cell-err-ic {
  font-size: 40rpx;
  color: var(--danger);
}
.cell-err-t {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: var(--sub);
  text-align: center;
}
.cell-tag {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  font-size: 20rpx;
  text-align: center;
  padding: 6rpx 0;
}
.cell-tag.saved {
  background: rgba(14, 138, 109, 0.92);
  color: #fff;
}
.cell-tag.savefail {
  background: rgba(217, 83, 79, 0.92);
  color: #fff;
}

/* 吸底操作栏 */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 16rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  background: var(--bg);
  border-top: 1rpx solid var(--line);
}
.sel-info {
  flex: none;
  font-size: 26rpx;
  color: var(--sub);
}
.btn-start,
.btn-saveall {
  flex: 1;
}
.btn-retry,
.btn-done {
  flex: 0 0 300rpx;
}

/* 生成中遮罩 */
.mask {
  position: fixed;
  inset: 0;
  z-index: 20;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
}
.mask-box {
  background: var(--card);
  border-radius: 20rpx;
  padding: 48rpx 64rpx;
  text-align: center;
}
.mask-t {
  font-size: 30rpx;
  font-weight: 600;
}
.mask-s {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--sub);
}

/* 页面底部给吸底栏让位 */
.page {
  padding-bottom: 160rpx;
}
