/* pages/batch/batch.wxss */
.page {
  padding: 24rpx 24rpx 0;
}

/* 说明卡 */
.tip-card {
  margin-bottom: 24rpx;
}
.tip-title {
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.5;
}
.tip-title.warn {
  color: var(--danger);
}
.tip-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--sub);
  line-height: 1.5;
}

/* 空态 */
.card.empty {
  text-align: center;
  color: var(--sub);
  padding: 60rpx 28rpx;
}
.empty-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
}

/* 勾选项 */
.pick-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.pick-item:last-child {
  border-bottom: none;
}
.picon {
  width: 88rpx;
  height: 118rpx;
  border-radius: 10rpx;
  background: var(--bg);
  overflow: hidden;
  flex: none;
}
.picon image {
  width: 100%;
  height: 100%;
}
.picon-ph {
  width: 100%;
  height: 100%;
}
.pinfo {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}
.pname {
  font-size: 28rpx;
  font-weight: 600;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.pdesc {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--sub);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.pcheck {
  flex: none;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 2rpx solid var(--line);
  margin-left: 20rpx;
  color: #fff;
  font-size: 26rpx;
  line-height: 44rpx;
  text-align: center;
}
.pick-item.on .pcheck {
  background: var(--primary);
  border-color: var(--primary);
}

/* 结果九宫格 */
.grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.cell {
  position: relative;
  /* 3 列九宫格，固定 3 列不随屏宽变（这是「一次打一套 ≤9 张」的语义，不是瀑布流）。
     ⚠️ 与首页网格同一个坑：((100% − 2×16rpx) / 3) 是零冗余写法，
     「3 张 + 2 个间距」刚好 100%，亚像素取整溢出即换行（第 3 张掉下一行）。
     末尾减 2rpx 冗余即解，详见 pages/home/home.wxss 与《响应式布局方案-v1.md》。 */
  width: calc((100% - 32rpx) / 3 - 2rpx);
  aspect-ratio: 3 / 4;
  background: var(--card);
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(40, 40, 30, 0.06);
}
.cell image {
  width: 100%;
  height: 100%;
}
.cell.bad {
  background: #FBF3F3;
}
.cell-err {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
  padding: 12rpx;
  box-sizing: border-box;
}
.cell-err-ic {
  font-size: 40rpx;
  color: var(--danger);
}
.cell-err-t {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: var(--sub);
  text-align: center;
}
.cell-tag {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  font-size: 20rpx;
  text-align: center;
  padding: 6rpx 0;
}
.cell-tag.saved {
  background: rgba(14, 138, 109, 0.92);
  color: #fff;
}
.cell-tag.savefail {
  background: rgba(217, 83, 79, 0.92);
  color: #fff;
}

/* 吸底操作栏 */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 16rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  background: var(--bg);
  border-top: 1rpx solid var(--line);
}
.sel-info {
  flex: none;
  font-size: 26rpx;
  color: var(--sub);
}
.btn-start,
.btn-saveall {
  flex: 1;
}
.btn-retry,
.btn-done {
  flex: 0 0 300rpx;
}

/* 生成中遮罩 */
.mask {
  position: fixed;
  inset: 0;
  z-index: 20;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
}
.mask-box {
  background: var(--card);
  border-radius: 20rpx;
  padding: 48rpx 64rpx;
  text-align: center;
}
.mask-t {
  font-size: 30rpx;
  font-weight: 600;
}
.mask-s {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--sub);
}

/* 页面底部给吸底栏让位 */
.page {
  padding-bottom: 160rpx;
}

/* ==================== 响应式：大屏（v2.0）====================
   三档口径 / 「大屏 px = 小屏 rpx ÷ 2」换算律 / 「媒体查询必须放末尾」等依据，
   见 app.wxss 顶部注释。
   九宫格维持固定 3 列：「一次打一套 ≤9 张」是语义，不做瀑布流。
   本页用默认的 .page-body（大屏上限 640px，不挂 -wide 变体）——
   九宫格 3 列在 640px 下每格约 208px，接近手机上的观感；放到 880px 每格 290px
   会让整屏装不下、失去「一屏看完一套」的用途。 */
@media (min-width: 600px) {
  .page { padding: 12px 12px 0; padding-bottom: 80px; }

  /* 吸底栏是 position: fixed，`margin: 0 auto` 对它**无效**——
     必须同时给 left:0 + right:0 + margin auto，max-width 才会起居中作用 */
  .bottom-bar {
    left: 0;
    right: 0;
    margin-left: auto;
    margin-right: auto;
    max-width: 640px;
    gap: 10px;
    padding: 8px 16px calc(12px + env(safe-area-inset-bottom));
  }

  .tip-card { margin-bottom: 12px; }
  .tip-title { font-size: 14px; }
  .tip-sub { margin-top: 4px; font-size: 12px; }
  .card.empty { padding: 30px 14px; }
  .empty-sub { margin-top: 6px; font-size: 12px; }

  .pick-item { padding: 10px 0; }
  .picon { width: 44px; height: 59px; border-radius: 5px; }
  .pinfo { margin-left: 10px; }
  .pname { font-size: 14px; }
  .pdesc { margin-top: 3px; font-size: 11px; }
  .pcheck {
    width: 22px;
    height: 22px;
    border-width: 1px;
    margin-left: 10px;
    font-size: 13px;
    line-height: 22px;
  }

  /* 九宫格：间距 16rpx → 8px，2 个间隙共 16px；末尾 1px 冗余防 1/64px 取整换行 */
  .grid { gap: 8px; }
  .cell {
    width: calc((100% - 16px) / 3 - 1px);
    border-radius: 8px;
    box-shadow: 0 2px 8px rgba(40, 40, 30, 0.06);
  }
  .cell-err { padding: 6px; }
  .cell-err-ic { font-size: 20px; }
  .cell-err-t { margin-top: 4px; font-size: 10px; }
  .cell-tag { font-size: 10px; padding: 3px 0; }

  .sel-info { font-size: 13px; }
  .mask { padding: 24px 32px; }
  .mask-t { font-size: 15px; }
  .mask-s { margin-top: 6px; font-size: 12px; }
}
