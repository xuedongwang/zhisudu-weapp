<!-- pages/config/config.wxml -->
<!-- 使用原生页面滚动（不用 scroll-view），吸底栏 fixed，保证任何机型都能正常滚动 -->

<!-- 分享落地承接（FR-15.8）：好友点开分享卡片直达本页时，说明「这张纸是别人配好的」，
     否则用户会以为是自己上次的设置或系统默认，分享的打动点就丢了 -->
<view class="share-tip" wx:if="{{fromShare && !tipClosed}}">
  <view class="st-body">
    <view class="st-title">朋友分享给你的{{layoutText}}配置</view>
    <view class="st-sub">参数已填好，可直接导出打印</view>
  </view>
  <view class="st-close" bindtap="closeShareTip" hover-class="st-close-hover">✕</view>
</view>

<view class="preview-area">
  <!-- 尺寸标签独立一行（右对齐），不与 canvas 重叠：iOS 真机 canvas 原生层会盖住重叠的 view -->
  <view class="stage-caption">
    <view class="size-tag">{{sizeText}} · {{layoutText}} · {{orientText}}</view>
  </view>
  <view class="paper-stage">
    <canvas type="2d" id="preview" class="preview-canvas"
            style="width: {{pw}}px; height: {{ph}}px;" />
  </view>
</view>

<view class="params-wrap">
  <view class="card param-card">
    <!-- 纸张规格（FR-17；v1.4 扩至 10 种规格 + 自定义尺寸） -->
    <view class="prow">
      <view class="plabel"><text class="b">纸张</text></view>
      <view class="chips">
        <view class="chip {{size === item.key ? 'on' : ''}}"
              wx:for="{{sizeOptions}}" wx:key="key"
              data-v="{{item.key}}" bindtap="onSize">{{item.name}}</view>
      </view>
    </view>

    <!-- 自定义尺寸（v1.4）：仅选中「自定义」时出现；单边 50~346mm（300DPI 下 ≤4093px，画布墙内） -->
    <view class="prow" wx:if="{{size === 'custom'}}">
      <view class="plabel"><text class="b">自定义尺寸</text><text class="pval">{{customW}} × {{customH}} mm</text></view>
      <view class="custom-size">
        <input class="cs-input" type="digit" value="{{customW}}" data-v="w" bindblur="onCustomW" bindconfirm="onCustomW" />
        <text class="cs-x">×</text>
        <input class="cs-input" type="digit" value="{{customH}}" data-v="h" bindblur="onCustomH" bindconfirm="onCustomH" />
        <text class="cs-unit">mm（{{customMin}}~{{customMax}}）</text>
      </view>
    </view>

    <!-- 版面划分（FR-18）：一张纸切成几个区块，每区独立选纸型 -->
    <view class="prow">
      <view class="plabel"><text class="b">版式</text><text class="pval">{{layoutText}}</text></view>
      <view class="chips">
        <view class="chip {{layout === item.key ? 'on' : ''}}"
              wx:for="{{layoutOptions}}" wx:key="key"
              data-v="{{item.key}}" bindtap="onLayout">{{item.name}}</view>
      </view>
    </view>

    <!-- 区块选择：仅多区块时出现，决定下方「纸型 / 格宽」作用于哪一格 -->
    <view class="prow" wx:if="{{multi}}">
      <view class="plabel"><text class="b">编辑区块</text><text class="pval">{{active + 1}} / {{blocks.length}}</text></view>
      <view class="chips">
        <view class="chip {{active === index ? 'on' : ''}}"
              wx:for="{{blocks}}" wx:key="index"
              data-i="{{index}}" bindtap="onPickBlock">{{item.shortName}}</view>
      </view>
    </view>

    <!-- 当前区块的纸型 -->
    <view class="prow">
      <view class="plabel"><text class="b">{{multi ? '区块纸型' : '纸型'}}</text><text class="pval">{{blockName}}</text></view>
      <scroll-view scroll-x class="paper-row" enhanced show-scrollbar="{{false}}">
        <view class="chip {{blockType === item.key ? 'on' : ''}}"
              wx:for="{{paperOptions}}" wx:key="key"
              data-v="{{item.key}}" bindtap="onBlockType">{{item.name}}</view>
      </scroll-view>
    </view>

    <!-- 方向 -->
    <view class="prow">
      <view class="plabel"><text class="b">方向</text></view>
      <view class="chips">
        <view class="chip {{orient === 'p' ? 'on' : ''}}" data-v="p" bindtap="onOrient">纵向</view>
        <view class="chip {{orient === 'l' ? 'on' : ''}}" data-v="l" bindtap="onOrient">横向</view>
      </view>
    </view>

    <!-- 格宽/行高/线距（FR-02.3）。
         v1.1：空白纸没有可调尺寸（papers.PAPERS[kongbai] 无 cell），hasCell 为假时整行隐藏 -->
    <view class="prow" wx:if="{{hasCell}}">
      <view class="plabel"><text class="b">{{cellLabel}}</text><text class="pval">{{cell}} mm</text></view>
      <slider min="{{cellMin}}" max="{{cellMax}}" step="{{cellStep}}" value="{{cell}}"
              activeColor="#0E8A6D" block-size="24" bindchanging="onCellInput" bindchange="onCellInput" />
    </view>

    <!-- 纸型专属参数（FR-02.7）：康奈尔线索栏宽、周计划行数等；
         v1.3 起支持开关型（书法格辅助线），渲染为开关而非滑杆 -->
    <view class="prow" wx:for="{{extras}}" wx:key="key">
      <view class="plabel"><text class="b">{{item.label}}</text><text class="pval">{{item.sw ? (item.value ? '开' : '关') : item.value + item.unit}}</text></view>
      <slider wx:if="{{!item.sw}}" min="{{item.min}}" max="{{item.max}}" step="{{item.step}}" value="{{item.value}}"
              activeColor="#0E8A6D" block-size="24" data-k="{{item.key}}"
              bindchanging="onExtraInput" bindchange="onExtraInput" />
      <switch wx:else checked="{{!!item.value}}" data-k="{{item.key}}" color="#0E8A6D"
              bindchange="onExtraSwitch" />
    </view>

    <!-- 边距（FR-02.5）：页面级，作用于整张纸 -->
    <view class="prow">
      <view class="plabel"><text class="b">边距</text><text class="pval">{{margin}} mm</text></view>
      <slider min="5" max="25" step="1" value="{{margin}}"
              activeColor="#0E8A6D" block-size="24" bindchanging="onMarginInput" bindchange="onMarginInput" />
    </view>

    <!-- 线色（FR-02.4）：页面级，一页纸共用一种笔色 -->
    <view class="prow">
      <view class="plabel"><text class="b">线条颜色</text></view>
      <view class="swatches">
        <view class="swatch {{color === item.value ? 'on' : ''}}"
              style="background: {{item.value}};"
              wx:for="{{colors}}" wx:key="value"
              data-v="{{item.value}}" bindtap="onColor" />
      </view>
    </view>

    <!-- 线型（FR-02.4） -->
    <view class="prow">
      <view class="plabel"><text class="b">线条样式</text></view>
      <view class="chips">
        <view class="chip {{style === item.value ? 'on' : ''}}"
              wx:for="{{styles}}" wx:key="value"
              data-v="{{item.value}}" bindtap="onStyle">{{item.name}}</view>
      </view>
    </view>

    <!-- ==================== 形式层（v1.2）====================
         全部是叠加在任意纸型上的整页属性：主题一键套用 → 各项仍可微调 -->

    <!-- 主题（一键套用一组外观参数；不是存储字段，故无选中态） -->
    <view class="prow">
      <view class="plabel"><text class="b">主题</text><text class="pval">套用后可微调</text></view>
      <view class="chips">
        <view class="chip" wx:for="{{themes}}" wx:key="key"
              data-v="{{item.key}}" bindtap="onTheme">{{item.name}}</view>
      </view>
    </view>

    <!-- 线条粗细（页面级倍率，×1.0 与旧版一致） -->
    <view class="prow">
      <view class="plabel"><text class="b">线条粗细</text><text class="pval">×{{weight}}</text></view>
      <slider min="{{weightMin}}" max="{{weightMax}}" step="{{weightStep}}" value="{{weight}}"
              activeColor="#0E8A6D" block-size="24" bindchanging="onWeightInput" bindchange="onWeightInput" />
    </view>

    <!-- 背景颜色（默认纯白） -->
    <view class="prow">
      <view class="plabel"><text class="b">背景颜色</text></view>
      <view class="swatches">
        <view class="swatch swatch-bg {{bgColor === item.value ? 'on' : ''}}"
              style="background: {{item.value}};"
              wx:for="{{bgColors}}" wx:key="value"
              data-v="{{item.value}}" bindtap="onBgColor" />
      </view>
    </view>

    <!-- 背景纹理（浅色满铺，跟随线色的低透明度） -->
    <view class="prow">
      <view class="plabel"><text class="b">背景纹理</text></view>
      <view class="chips">
        <view class="chip {{bgTexture === item.value ? 'on' : ''}}"
              wx:for="{{bgTextures}}" wx:key="value"
              data-v="{{item.value}}" bindtap="onBgTexture">{{item.name}}</view>
      </view>
    </view>

    <!-- 页面边框（画在页缘内缩 4mm 处） -->
    <view class="prow">
      <view class="plabel"><text class="b">页面边框</text></view>
      <view class="chips">
        <view class="chip {{border === item.value ? 'on' : ''}}"
              wx:for="{{borders}}" wx:key="value"
              data-v="{{item.value}}" bindtap="onBorder">{{item.name}}</view>
      </view>
    </view>

    <!-- 文字水印（留空即关闭；内容不上报埋点） -->
    <view class="prow">
      <view class="plabel"><text class="b">文字水印</text><text class="pval">{{wmText ? '已开启' : '留空关闭'}}</text></view>
      <input class="wm-input" value="{{wmText}}" maxlength="12" placeholder="如：草稿 · 最多 12 字"
             placeholder-class="wm-ph" bindinput="onWmText" />
    </view>
    <view class="prow" wx:if="{{wmText}}">
      <view class="plabel"><text class="b">水印透明度</text><text class="pval">{{wmAlpha}}</text></view>
      <slider min="{{wmAlphaMin}}" max="{{wmAlphaMax}}" step="0.01" value="{{wmAlpha}}"
              activeColor="#0E8A6D" block-size="24" bindchanging="onWmAlphaInput" bindchange="onWmAlphaInput" />
    </view>
    <view class="prow" wx:if="{{wmText}}">
      <view class="plabel"><text class="b">水印角度</text><text class="pval">{{wmAngle}}°</text></view>
      <slider min="{{wmAngleMin}}" max="{{wmAngleMax}}" step="1" value="{{wmAngle}}"
              activeColor="#0E8A6D" block-size="24" bindchanging="onWmAngleInput" bindchange="onWmAngleInput" />
    </view>

    <!-- 口算纸分栏（FR-02.6） -->
    <view class="prow" wx:if="{{hasCols}}">
      <view class="plabel"><text class="b">分栏数</text><text class="pval">{{cols}} 栏</text></view>
      <view class="chips">
        <view class="chip {{cols === 1 ? 'on' : ''}}" data-v="1" bindtap="onCols">1 栏</view>
        <view class="chip {{cols === 2 ? 'on' : ''}}" data-v="2" bindtap="onCols">2 栏</view>
        <view class="chip {{cols === 3 ? 'on' : ''}}" data-v="3" bindtap="onCols">3 栏</view>
      </view>
    </view>
  </view>

  <view class="export-note">导出规格：{{exportNote}}</view>
  <!-- 底部留白由 .params-wrap 的 padding-bottom 提供（含吸底栏高度与安全区） -->
</view>

<!-- 吸底操作栏 -->
<view class="bottom-bar">
  <button class="btn btn-plain btn-save" bindtap="onSaveTemplate" hover-class="none">{{isFromTpl ? '更新模板' : '存为模板'}}</button>
  <button class="btn btn-primary btn-export" bindtap="onExport" disabled="{{exporting}}" hover-class="none">导出图片</button>
</view>
