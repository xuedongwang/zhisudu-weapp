/* pages/config/config.wxss */
/* 原生页面滚动：page 高度自适应，吸底栏 fixed */

/* 分享落地提示条（FR-15.8）：只在 from=share 进入时出现，可关闭 */
.share-tip {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 24rpx 32rpx 0;
  padding: 22rpx 20rpx 22rpx 24rpx;
  background: var(--primary-weak);
  border-radius: 18rpx;
}
.st-body { flex: 1; min-width: 0; }
.st-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--primary-deep);
}
.st-sub {
  font-size: 22rpx;
  color: var(--primary);
  margin-top: 6rpx;
}
.st-close {
  flex: none;
  width: 52rpx;
  height: 52rpx;
  line-height: 52rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--primary);
}
.st-close-hover { opacity: 0.5; }

/* 预览区：顶部留白保证标签不被导航栏裁切 */
.preview-area {
  padding: 28rpx 32rpx 20rpx;
}
.paper-stage {
  background: #FDFCFA;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 32rpx rgba(40, 40, 30, 0.12);
  padding: 20rpx;
  position: relative;
}
/* 尺寸标签：独立行右对齐，不叠在 canvas 上（iOS 真机 canvas 原生层会盖住重叠区域） */
.stage-caption {
  display: flex;
  justify-content: flex-end;
  padding: 0 8rpx 12rpx;
}
.size-tag {
  background: rgba(43, 43, 40, 0.82);
  color: #fff;
  font-size: 20rpx;
  line-height: 1;
  padding: 8rpx 18rpx;
  border-radius: 18rpx;
}
.preview-canvas {
  display: block;
  border-radius: 8rpx;
  background: #fff;
}

/* 参数区：底部 padding 预留吸底栏高度（96 按钮 + 40 上下内边距）+ 安全区，保证最后一行能滚出遮挡 */
.params-wrap {
  padding: 0 32rpx calc(180rpx + env(safe-area-inset-bottom));
}
.param-card { padding: 4rpx 32rpx; }
.prow {
  padding: 26rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.prow:last-child { border-bottom: none; }
.plabel {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 26rpx;
  margin-bottom: 18rpx;
}
.plabel .b { font-weight: 600; }
.pval {
  color: var(--primary);
  font-weight: 700;
  font-family: Menlo, monospace;
}
.chips { display: flex; gap: 16rpx; flex-wrap: wrap; }

/* 区块纸型横向滚动：24 种纸型放不下一行，用 scroll-x + inline-block（flex 会撑破容器） */
.paper-row {
  width: 100%;
  white-space: nowrap;
}
.paper-row .chip {
  display: inline-block;
  margin-right: 16rpx;
}

/* 色板 */
.swatches { display: flex; gap: 28rpx; }
.swatch {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 5rpx solid transparent;
  box-shadow: inset 0 0 0 4rpx #fff;
  box-sizing: border-box;
}
.swatch.on { border-color: var(--primary); }

/* v1.2 背景色样片：含纯白与浅色系，需浅灰描边才能在白卡上看清边界 */
.swatch-bg { box-shadow: inset 0 0 0 4rpx #fff, 0 0 0 2rpx #E3E3DC; }

/* v1.2 水印输入框 */
.wm-input {
  flex: 1;
  height: 64rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
  background: #F7F7F4;
  border-radius: 12rpx;
  box-sizing: border-box;
}
.wm-ph { color: var(--sub); font-size: 24rpx; }

.export-note {
  font-size: 22rpx;
  color: var(--sub);
  text-align: center;
  margin-top: 24rpx;
}

/* 吸底操作栏（fixed，脱离文档流） */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  display: flex;
  gap: 20rpx;
  padding: 16rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  background: var(--bg);
  border-top: 1rpx solid var(--line);
}
.btn-save { flex: 0 0 220rpx; }
.btn-export { flex: 1; }

/* v1.4 自定义尺寸输入行 */
.custom-size {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.cs-input {
  width: 140rpx;
  padding: 10rpx 16rpx;
  background: #fff;
  border: 1rpx solid var(--line);
  border-radius: 10rpx;
  font-size: 26rpx;
  text-align: center;
}
.cs-x { color: var(--sub); font-size: 26rpx; }
.cs-unit { color: var(--sub); font-size: 22rpx; }
