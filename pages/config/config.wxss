/* pages/config/config.wxss */
/* 原生页面滚动：page 高度自适应，吸底栏 fixed */

/* 分享落地提示条（FR-15.8）：只在 from=share 进入时出现，可关闭 */
.share-tip {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 24rpx 32rpx 0;
  padding: 22rpx 20rpx 22rpx 24rpx;
  background: var(--primary-weak);
  border-radius: 18rpx;
}
.st-body { flex: 1; min-width: 0; }
.st-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--primary-deep);
}
.st-sub {
  font-size: 22rpx;
  color: var(--primary);
  margin-top: 6rpx;
}
.st-close {
  flex: none;
  width: 52rpx;
  height: 52rpx;
  line-height: 52rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--primary);
}
.st-close-hover { opacity: 0.5; }

/* 预览区：顶部留白保证标签不被导航栏裁切 */
.preview-area {
  padding: 28rpx 32rpx 20rpx;
}
.paper-stage {
  /* 无台面样式（用户 2026-09-29 定稿）：白色纸张直接浮在页面底色（--bg #F6F5F1）上，
     不用深色台面。此前试过中性米灰台面 + 台面外阴影，观感偏重，改回「去掉背景」。
     内边距为 0：纸张宽度与下方参数卡片对齐（各占页面宽 - 32rpx×2）；
     ⚠️ 改这里必须同步 config.js 的 _initPreview 宽度计算（原来按含 20rpx×2 的 104rpx 扣减） */
  background: transparent;
  padding: 0;
  position: relative;
}
/* 尺寸标签：独立行右对齐，不叠在 canvas 上（iOS 真机 canvas 原生层会盖住重叠区域） */
.stage-caption {
  display: flex;
  justify-content: flex-end;
  padding: 0 0 12rpx; /* 左右不再缩进：标签右缘与纸张右缘对齐（纸张已与参数卡片同宽） */
}
.size-tag {
  background: rgba(43, 43, 40, 0.82);
  color: #fff;
  font-size: 20rpx;
  line-height: 1;
  padding: 8rpx 18rpx;
  border-radius: 18rpx;
}
.preview-canvas {
  display: block;
  border-radius: 8rpx;
  background: #fff;
  /* 纸张分层：柔和投影 + 1rpx 极细描边环（用 spread 阴影实现，不占布局、
     不影响原生 canvas 尺寸），与页面底色 #F6F5F1 形成清晰但不厚重的边界
     —— 相当于把原型里 paper-stage 的 1px 描边移到纸张自身 */
  box-shadow: 0 4rpx 16rpx rgba(40, 40, 30, 0.12), 0 0 0 1rpx rgba(40, 40, 30, 0.07);
}

/* 参数区：底部 padding 预留吸底栏高度（96 按钮 + 40 上下内边距）+ 安全区，保证最后一行能滚出遮挡 */
.params-wrap {
  padding: 0 32rpx calc(180rpx + env(safe-area-inset-bottom));
}
.param-card { padding: 4rpx 32rpx; }
.prow {
  padding: 26rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.prow:last-child { border-bottom: none; }
.plabel {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 26rpx;
  margin-bottom: 18rpx;
}
.plabel .b { font-weight: 600; }
.pval {
  color: var(--primary);
  font-weight: 700;
  font-family: Menlo, monospace;
}
.chips { display: flex; gap: 16rpx; flex-wrap: wrap; }

/* 区块纸型横向滚动：24 种纸型放不下一行，用 scroll-x + inline-block（flex 会撑破容器） */
.paper-row {
  width: 100%;
  white-space: nowrap;
  /* v1.4 修复（用户反馈①）：scroll-view 内部是 overflow 裁切，此前 chip 上下贴边，
     选中项底部的 3rpx 主色描边正好压在容器下缘被裁掉（远看像「下方少一截」）。
     上下各留 8rpx 内边距把内容撑离边缘，描边完整可见。 */
  padding: 8rpx 0;
}
.paper-row .chip {
  display: inline-block;
  margin-right: 16rpx;
}

/* 色板：v1.4 改为换行排列（用户反馈②）。
   11 色 × 56rpx + 10 个 26rpx 间距 ≈ 876rpx，远超卡片内容宽（约 622rpx），
   原先不换行 → flex 默认收缩把圆形挤成扁椭圆；换行后 7 + 4 两行排完。 */
.swatches { display: flex; flex-wrap: wrap; gap: 20rpx 26rpx; }
.swatch {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 5rpx solid transparent;
  box-shadow: inset 0 0 0 4rpx #fff;
  box-sizing: border-box;
  /* 兜底：无论容器多窄都不参与收缩，宁可换行也不变形 */
  flex: none;
}
.swatch.on { border-color: var(--primary); }

/* v1.2 背景色样片：含纯白与浅色系，需浅灰描边才能在白卡上看清边界 */
.swatch-bg { box-shadow: inset 0 0 0 4rpx #fff, 0 0 0 2rpx #E3E3DC; }

/* v1.2 水印输入框 */
.wm-input {
  flex: 1;
  height: 64rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
  background: #F7F7F4;
  border-radius: 12rpx;
  box-sizing: border-box;
}
.wm-ph { color: var(--sub); font-size: 24rpx; }

.export-note {
  font-size: 22rpx;
  color: var(--sub);
  text-align: center;
  margin-top: 24rpx;
}

/* 吸底操作栏（fixed，脱离文档流） */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  display: flex;
  gap: 20rpx;
  padding: 16rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  background: var(--bg);
  border-top: 1rpx solid var(--line);
}
.btn-save { flex: 0 0 220rpx; }
.btn-export { flex: 1; }

/* v1.4 自定义尺寸输入行 */
.custom-size {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.cs-input {
  width: 140rpx;
  padding: 10rpx 16rpx;
  background: #fff;
  border: 1rpx solid var(--line);
  border-radius: 10rpx;
  font-size: 26rpx;
  text-align: center;
}
.cs-x { color: var(--sub); font-size: 26rpx; }
.cs-unit { color: var(--sub); font-size: 22rpx; }

/* ============ 外观与样式折叠区（v1.4 渐进式披露）============
   设计依据《设置页信息架构优化方案-v1.md》方案 C：一个折叠行 + 展开后两个小标题。
   折叠行整行可点（bindtap 在 .fold-head 上），比只点箭头的手势容错大得多。 */
.fold-head {
  padding: 30rpx 0 26rpx;
}
.fold-head-hover { opacity: 0.55; }
.fold-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.fold-title {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.fold-name { font-size: 30rpx; font-weight: 600; }
/* 状态点：存在非默认外观时亮起——「有改动」这件事看得见，而不是被折叠藏掉（方案 v1 第 4.3 节） */
.fold-dot {
  flex: none;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--primary);
}
.fold-head-r {
  flex: none;
  display: flex;
  align-items: center;
  gap: 10rpx;
  max-width: 360rpx; /* 摘要最长约 10 字（3 项）≈312rpx，留出箭头位置不被挤省略号 */
}
.fold-sum {
  /* min-width:0 必需：flex 项默认 min-width:auto，不给它就没法收缩，ellipsis 永不生效 */
  min-width: 0;
  font-size: 24rpx;
  color: var(--sub);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.fold-sum.on { color: var(--primary); font-weight: 700; }
.fold-caret {
  flex: none;
  font-size: 22rpx;
  color: var(--sub);
  transition: transform 0.2s ease;
}
.fold-caret.on { transform: rotate(180deg); }
/* 副标题：不换行（一行说明清），放不下时省略号——两行会把折叠行撑高、削弱「一行入口」的观感 */
.fold-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--sub);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 折叠区内的小标题（线条与颜色 / 纸张背景与装饰）：不设二级折叠，避免「点了还要再点」 */
.group-title {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 26rpx 0 4rpx;
  font-size: 22rpx;
  color: var(--sub);
}
/* 标题右侧延伸的细线：不占布局、把分组边界做出来 */
.group-title::after {
  content: '';
  flex: 1;
  height: 1rpx;
  background: var(--line);
}
/* 首个小标题紧跟折叠行，不再叠加 26rpx 上间距（否则两段留白相加显得断层） */
.group-title.first { padding-top: 0; }
