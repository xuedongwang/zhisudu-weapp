/* pages/favs/favs.wxss */
.page { padding: 24rpx 32rpx; }
.card { padding: 8rpx 28rpx; }
.fav-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.fav-item:last-child { border-bottom: none; }
.ficon {
  width: 60rpx;
  height: 84rpx;
  border: 1rpx solid var(--line);
  border-radius: 10rpx;
  background: #FDFCFA;
  flex: none;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}
.ficon image { width: 100%; height: 100%; display: block; }
.finfo { flex: 1; min-width: 0; }
.fname { font-size: 27rpx; font-weight: 500; }
.fdesc { font-size: 22rpx; color: var(--sub); margin-top: 4rpx; }
.fopen,
.fdel {
  flex: none;
  font-size: 23rpx;
  border-radius: 28rpx;
  padding: 0 24rpx;
  line-height: 52rpx;
  text-align: center;
}
.fopen {
  color: var(--primary);
  border: 3rpx solid var(--primary);
  background: #fff;
  font-weight: 600;
}
.fdel { color: var(--sub); background: #F0EEE8; }
.tbtn-hover { opacity: 0.7; }

/* ==================== 响应式：大屏（v2.0）====================
   依据见 app.wxss 顶部（三档口径 / 「大屏 px = 小屏 rpx ÷ 2」换算律 /
   媒体查询必须放文件末尾）。手机竖屏永不命中 → 手机端零变化。 */
@media (min-width: 600px) {
  .page { padding: 12px 16px; }
  /* 本页 .card 的紧凑内边距覆盖了全局 .card 的 28rpx，大屏同样要跟着覆盖 */
  .card { padding: 4px 14px; }

  .fav-item { gap: 10px; padding: 12px 0; }
  .ficon { width: 30px; height: 42px; border-radius: 5px; }
  .fname { font-size: 13.5px; }
  .fdesc { font-size: 11px; margin-top: 2px; }
  .fopen,
  .fdel {
    font-size: 11.5px;
    border-radius: 14px;
    padding: 0 12px;
    line-height: 26px;
  }
  .fopen { border-width: 2px; }
}
