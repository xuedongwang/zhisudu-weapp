/* pages/history/history.wxss */
.page { padding: 24rpx 32rpx 0; }

/* ===== 统计卡 ===== */
.stat-card { padding: 30rpx 32rpx; }
.stat-line { display: flex; align-items: baseline; gap: 8rpx; }
.stat-num {
  font-size: 60rpx;
  font-weight: 700;
  color: var(--primary);
  font-family: Menlo, monospace;
  line-height: 1;
}
.stat-unit { font-size: 26rpx; color: var(--primary); font-weight: 600; }
.stat-label {
  margin-left: 12rpx;
  font-size: 24rpx;
  color: var(--sub);
}
.stat-top {
  margin-top: 16rpx;
  font-size: 23rpx;
  color: var(--sub);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ===== 历史列表 ===== */
.his-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.his-item:last-child { border-bottom: none; }
.hicon {
  width: 60rpx;
  height: 84rpx;
  border: 1rpx solid var(--line);
  border-radius: 10rpx;
  background: #FDFCFA;
  flex: none;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}
.hicon image { width: 100%; height: 100%; display: block; }
.hinfo { flex: 1; min-width: 0; }
.hname {
  font-size: 27rpx;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.hmeta { font-size: 22rpx; color: var(--sub); margin-top: 4rpx; }
.hbtn {
  flex: none;
  font-size: 23rpx;
  border-radius: 28rpx;
  padding: 0 24rpx;
  line-height: 52rpx;
  text-align: center;
  box-sizing: border-box;
  border: 3rpx solid var(--primary);
  color: var(--primary);
  background: #fff;
  font-weight: 600;
}
.hbtn-hover { opacity: 0.7; }

/* ===== 清空（危险操作：红字红描边，与模板删除一致） ===== */
.btn-danger-outline {
  margin: 40rpx 0 0;
  background: #fff;
  color: var(--danger);
  border: 3rpx solid var(--danger);
  font-size: 28rpx;
}
.foot-note {
  margin-top: 20rpx;
  font-size: 22rpx;
  color: var(--sub);
  text-align: center;
}

/* ===== 空态 ===== */
.empty { padding: 64rpx 32rpx; }
.empty-sub {
  margin-top: 12rpx;
  font-size: 23rpx;
  color: #B9B6AA;
}
.btn-go {
  margin: 40rpx auto 0;
  width: 360rpx;
}

/* ==================== 响应式：大屏（v2.0）====================
   依据见 app.wxss 顶部（三档口径 / 「大屏 px = 小屏 rpx ÷ 2」换算律 /
   媒体查询必须放文件末尾）。手机竖屏永不命中 → 手机端零变化。 */
@media (min-width: 600px) {
  .page { padding: 12px 16px 0; }

  .stat-card { padding: 15px 16px; }
  .stat-line { gap: 4px; }
  .stat-num { font-size: 30px; }
  .stat-unit { font-size: 13px; }
  .stat-label { margin-left: 6px; font-size: 12px; }
  .stat-top { margin-top: 8px; font-size: 11.5px; }

  .his-item { gap: 10px; padding: 12px 0; }
  .hicon { width: 30px; height: 42px; border-radius: 5px; }
  .hname { font-size: 13.5px; }
  .hmeta { font-size: 11px; margin-top: 2px; }
  .hbtn {
    font-size: 11.5px;
    border-radius: 14px;
    padding: 0 12px;
    line-height: 26px;
    border-width: 2px;
  }

  .btn-danger-outline { margin: 20px 0 0; font-size: 14px; }
  .foot-note { margin-top: 10px; font-size: 11px; }

  .empty { padding: 32px 16px; }
  .empty-sub { margin-top: 6px; font-size: 11.5px; }
  .btn-go { margin: 20px auto 0; width: 180px; }
}
