<!-- pages/home/home.wxml -->
<view class="page">
  <!-- 顶部品牌区（标题 + 副标题一行） -->
  <view class="home-head">
    <view class="name">纸<text class="em">速</text>打</view>
    <view class="slogan">一分钟，打好一张练习纸</view>
  </view>

  <scroll-view scroll-y class="scroll" enhanced show-scrollbar="{{false}}">
    <!-- 收藏置顶 -->
    <view class="sec-title" style="margin-top: 8rpx;">我的收藏</view>
    <scroll-view scroll-x class="fav-row" enhanced show-scrollbar="{{false}}" wx:if="{{favs.length}}">
      <view class="fav-chip" wx:for="{{favs}}" wx:key="key"
            data-type="{{item.key}}" data-source="fav" bindtap="openConfig">
        <text class="star">★</text>{{item.name}}
      </view>
    </scroll-view>
    <view class="card empty" wx:else>☆ 长按纸型卡片可收藏，收藏后置顶在这里</view>

    <!-- 纸型分类分组（FR-01）：12 种纸型按用途分四类，原先把全部纸型塞在「儿童场景纸」
         一个标题下，新增中学 / 成人向纸型后标题名不副实 -->
    <block wx:for="{{groups}}" wx:key="key" wx:for-item="g">
      <view class="sec-title">{{g.name}}<text class="more">{{g.papers.length}} 种</text></view>
      <view class="paper-grid">
        <view class="paper-card" wx:for="{{g.papers}}" wx:key="key"
              data-type="{{item.key}}" data-source="group" bindtap="openConfig"
              bindlongpress="onPaperLongPress" hover-class="pressed">
          <view class="paper-thumb">
            <image wx:if="{{item.thumb}}" src="{{item.thumb}}" mode="aspectFit" />
            <view wx:else class="thumb-loading" />
          </view>
          <view class="pname">{{item.name}}</view>
          <view class="pdesc">{{item.desc}}</view>
        </view>
      </view>
    </block>

    <!-- 最近生成（参数复用快捷入口；完整流水与累计张数在打印历史页） -->
    <view class="sec-title" wx:if="{{recent.length}}">最近生成<text class="more" style="padding: 12rpx 0 12rpx 24rpx;" bindtap="goHistory">{{hisTotal ? '共 ' + hisTotal + ' 张 ›' : '查看全部 ›'}}</text></view>
    <view class="card recent-card" wx:if="{{recent.length}}">
      <view class="recent-item" wx:for="{{recent}}" wx:key="index">
        <!-- 缩略图：占位与真图共用同一盒子，图片回填时行高不跳 -->
        <view class="ricon">
          <image wx:if="{{item.thumb}}" src="{{item.thumb}}" mode="aspectFit" />
          <view wx:else class="ricon-ph" />
        </view>

        <!-- 文字区：吃掉剩余宽度并自行打点，不向内挤压按钮 -->
        <view class="rinfo">
          <view class="rname">{{item.title}}</view>
          <view class="rdesc">{{item.desc}}</view>
        </view>

        <!-- 「再次生成」自绘按钮：用 view 实现，不用原生 button 组件。
             原生 wx-button 内置 wx-button:not([size=mini]) { width:184px; margin:auto }
             加上 ::after 描边与内置 padding/line-height，想让宽度仅由文案决定就得逐条反覆盖，
             机型/基础库一变就失控；view 零默认样式，宽度收敛且可靠 -->
        <view class="rbtn" data-index="{{index}}" bindtap="reuseRecent"
              hover-class="rbtn-hover" hover-stay-time="120">
          <text class="rbtn-txt">再次生成</text>
        </view>
      </view>
    </view>

    <view style="height: 40rpx;" />
  </scroll-view>
</view>
