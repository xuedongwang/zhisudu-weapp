/* pages/home/home.wxss */
.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.home-head {
  padding: 24rpx 40rpx 8rpx;
  flex: none;
  display: flex;
  align-items: baseline;
  gap: 20rpx;
}
.home-head .name {
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}
.home-head .em { color: var(--primary); }
.home-head .slogan {
  font-size: 24rpx;
  color: var(--sub);
}

.scroll {
  flex: 1;
  padding: 0 32rpx;
  box-sizing: border-box;
  min-height: 0;
}

/* 收藏行 */
.fav-row { white-space: nowrap; }
.fav-chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  background: #fff;
  border-radius: 40rpx;
  padding: 14rpx 28rpx;
  font-size: 26rpx;
  font-weight: 500;
  box-shadow: 0 6rpx 24rpx rgba(40, 40, 30, 0.08);
  margin-right: 16rpx;
}
.fav-chip .star { color: #F5A623; }

/* 纸型卡片 */
.paper-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
}
.paper-card {
  width: calc(50% - 12rpx);
  background: #fff;
  border-radius: 28rpx;
  box-shadow: 0 6rpx 24rpx rgba(40, 40, 30, 0.08);
  padding: 24rpx;
  box-sizing: border-box;
}
.pressed { transform: scale(0.97); }
.paper-thumb {
  width: 100%;
  height: 320rpx;
  border-radius: 16rpx;
  background: #FDFCFA;
  border: 1rpx solid var(--line);
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}
.paper-thumb image { width: 100%; height: 100%; }
.thumb-loading { width: 60%; height: 80%; background: #F2F0EA; border-radius: 8rpx; }
.pname { font-size: 28rpx; font-weight: 600; margin-top: 18rpx; }
.pdesc { font-size: 22rpx; color: var(--sub); margin-top: 4rpx; }

/* 最近记录 */
.recent-card { padding: 8rpx 28rpx; }
.recent-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.recent-item:last-child { border-bottom: none; }

/* 缩略图：A4 竖版比例；占位块与真图共用同一盒子，异步回填时行高不跳 */
.ricon {
  width: 72rpx;
  height: 100rpx;
  border-radius: 10rpx;
  border: 1rpx solid var(--line);
  background: #FDFCFA;
  flex: none;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}
.ricon image { width: 100%; height: 100%; }
.ricon-ph { width: 60%; height: 72%; background: #F2F0EA; border-radius: 6rpx; }

/* 文字区：吃掉全部剩余宽度并自行打点，保证它不会被内容反向挤宽 */
.rinfo { flex: 1; min-width: 0; }
.rname {
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
/* 第二行规格描述（时间已按产品口径移除，不再占用横向空间）：
   block 独占一行 + 单行 ellipsis，长文案裁自己，不推挤右侧按钮 */
.rdesc {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.4;
  color: var(--sub);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 「再次生成」自绘按钮：改用 view 实现，彻底弃用原生 button 组件。
   原生 wx-button 内置 wx-button:not([size=mini]) 带 width:184px 与
   margin-left/right:auto，另有 ::after 描边和内置 padding/line-height；
   想让宽度仅由文案决定就必须逐条反覆盖，机型/基础库一变即失控。
   view 零默认样式，宽度 = 文案 + padding，最稳；高度锁死（不用 line-height 撑高，
   文案换行会把按钮高度翻倍，导出页历史问题） */
.rbtn {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 56rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  border-radius: 28rpx;
  background: var(--primary-weak);
  color: var(--primary);
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1;
  white-space: nowrap;
  overflow: hidden;
  transition: background-color 0.12s ease, color 0.12s ease, transform 0.12s ease;
}
.rbtn-txt { line-height: 1; }
/* 按压反馈自己给：胶囊反白到主色 + 轻微缩放下沉，替代原生 hover-class 的灰遮罩 */
.rbtn-hover {
  background: var(--primary);
  color: #fff;
  transform: scale(0.96);
}
