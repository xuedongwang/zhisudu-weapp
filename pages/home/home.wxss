/* pages/home/home.wxss */
.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.home-head {
  padding: 24rpx 40rpx 8rpx;
  flex: none;
  display: flex;
  align-items: baseline;
  gap: 20rpx;
}
.home-head .name {
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}
.home-head .em { color: var(--primary); }
.home-head .slogan {
  font-size: 24rpx;
  color: var(--sub);
}

.scroll {
  flex: 1;
  padding: 0 32rpx;
  box-sizing: border-box;
  min-height: 0;
}

/* 收藏行 */
.fav-row { white-space: nowrap; }
.fav-chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  background: #fff;
  border-radius: 40rpx;
  padding: 14rpx 28rpx;
  font-size: 26rpx;
  font-weight: 500;
  box-shadow: 0 6rpx 24rpx rgba(40, 40, 30, 0.08);
  margin-right: 16rpx;
}
.fav-chip .star { color: #F5A623; }

/* 纸型卡片网格 */
.paper-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
}
.paper-card {
  /* 手机（默认）：2 列。
     ⚠️ 不能写 calc(50% - 12rpx)——那是「2 张卡 + 1 个间距 = 100%」的**零冗余**写法。
     WebKit 布局按 1/64px 取整（LayoutUnit），这种算式一旦有任何一位不能整除，
     取整后的「两张卡 + 间距」会比容器宽出不到 0.02px；而 flex 换行判定是
     「放不下就换行」，**溢出 1/64px 也算放不下** → 第二张直接掉到下一行。
     实测 iPhone 15 Pro（393pt）：内容宽 359.46px、卡宽 173.44px 都不是 1/64 的整数倍，
     必现；375pt 屏恰好整除（343px → 165.5px）所以旧版在那台机器上正常——
     这正是「本来一排两个，换个机型就变一个」的根因（详见《响应式布局方案-v1.md》）。
     公式：((100% − (n−1) × 间距) / n) − 冗余；冗余取 2rpx(≈1px)，
     已远超取整误差（4 列累计 ≤0.06px），视觉上完全看不出，但换行判定就稳了。 */
  width: calc((100% - 24rpx) / 2 - 2rpx);
  background: #fff;
  border-radius: 28rpx;
  box-shadow: 0 6rpx 24rpx rgba(40, 40, 30, 0.08);
  padding: 24rpx;
  box-sizing: border-box;
}
.pressed { transform: scale(0.97); }
.paper-thumb {
  width: 100%;
  height: 320rpx;
  border-radius: 16rpx;
  background: #FDFCFA;
  border: 1rpx solid var(--line);
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}
.paper-thumb image { width: 100%; height: 100%; }
.thumb-loading { width: 60%; height: 80%; background: #F2F0EA; border-radius: 8rpx; }
.pname { font-size: 28rpx; font-weight: 600; margin-top: 18rpx; }
.pdesc { font-size: 22rpx; color: var(--sub); margin-top: 4rpx; }

/* 最近记录 */
.recent-card { padding: 8rpx 28rpx; }
.recent-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.recent-item:last-child { border-bottom: none; }

/* 缩略图：A4 竖版比例；占位块与真图共用同一盒子，异步回填时行高不跳 */
.ricon {
  width: 72rpx;
  height: 100rpx;
  border-radius: 10rpx;
  border: 1rpx solid var(--line);
  background: #FDFCFA;
  flex: none;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}
.ricon image { width: 100%; height: 100%; }
.ricon-ph { width: 60%; height: 72%; background: #F2F0EA; border-radius: 6rpx; }

/* 文字区：吃掉全部剩余宽度并自行打点，保证它不会被内容反向挤宽 */
.rinfo { flex: 1; min-width: 0; }
.rname {
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
/* 第二行规格描述（时间已按产品口径移除，不再占用横向空间）：
   block 独占一行 + 单行 ellipsis，长文案裁自己，不推挤右侧按钮 */
.rdesc {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.4;
  color: var(--sub);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 「再次生成」自绘按钮：改用 view 实现，彻底弃用原生 button 组件。
   原生 wx-button 内置 wx-button:not([size=mini]) 带 width:184px 与
   margin-left/right:auto，另有 ::after 描边和内置 padding/line-height；
   想让宽度仅由文案决定就必须逐条反覆盖，机型/基础库一变即失控。
   view 零默认样式，宽度 = 文案 + padding，最稳；高度锁死（不用 line-height 撑高，
   文案换行会把按钮高度翻倍，导出页历史问题） */
.rbtn {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 56rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  border-radius: 28rpx;
  background: var(--primary-weak);
  color: var(--primary);
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1;
  white-space: nowrap;
  overflow: hidden;
  transition: background-color 0.12s ease, color 0.12s ease, transform 0.12s ease;
}
.rbtn-txt { line-height: 1; }
/* 按压反馈自己给：胶囊反白到主色 + 轻微缩放下沉，替代原生 hover-class 的灰遮罩 */
.rbtn-hover {
  background: var(--primary);
  color: #fff;
  transform: scale(0.96);
}

/* ==================== 响应式：大屏多列（v1.5）====================
   为什么放在文件末尾：媒体查询里的规则与上面的 `.paper-thumb` 等**同权重**，
   CSS 同权重靠后者覆盖，写在前面会被后面的基础样式盖掉（这是个很容易踩的坑）。

   为什么用 px 断点：rpx 的换算依赖屏宽，而媒体查询本身就是在按屏宽分支，
   在 `@media` 里写 rpx 没有意义。断点取 600px / 900px——
   600 覆盖平板竖屏（iPad 768pt、折叠屏展开 ~673pt），900 覆盖平板横屏（1024pt+）。

   ⚠️ 只在「显示区域真的这么宽」时才命中：
   - 手机竖屏（320~430pt）永远不命中 → **对手机端零影响**；
   - 微信 iPad 版默认以手机尺寸的小窗运行小程序（app.json 未开 `resizable`），
     也不会命中；要真正拿到宽显示区域需在 app.json 加 `"resizable": true`
     （基础库 2.3.0+ 支持 iPad 旋转；2.21.3+ 在 Windows/Mac/车机/WMPF 启用大屏模式）。

   ⚠️ 遗留：字号/内边距仍是 rpx，在 ≥768px 的屏上会跟着屏宽等比放大
   （rpx 的定义就是 750rpx = 整个屏宽，768pt 的 iPad 上 750rpx = 768px，
   等于手机上的 2 倍）。只改列数能缓解「一张卡占满整屏」，但不等于完整的大屏适配；
   要彻底解决需在本分支内把字号/内边距也改成 px——方案见《响应式布局方案-v1.md》。 */
@media (min-width: 600px) {
  .paper-grid { gap: 28rpx; }
  .paper-card { width: calc((100% - 56rpx) / 3 - 2rpx); }
  /* 3 列后卡片变窄，缩略图若继续用固定 320rpx 高会被拉成长条，
     改为按 A4 竖版比例（3:4）跟着卡宽自适应 */
  .paper-thumb { height: auto; aspect-ratio: 3 / 4; }
}
@media (min-width: 900px) {
  .paper-grid { gap: 28rpx; }
  .paper-card { width: calc((100% - 84rpx) / 4 - 2rpx); }
}
