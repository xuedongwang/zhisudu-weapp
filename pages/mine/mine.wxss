/* pages/mine/mine.wxss */
.page {
  padding: 24rpx 32rpx 0;
  box-sizing: border-box;
}

/* ===== 用户资料卡 ===== */
.profile-card {
  display: flex;
  align-items: center;
  gap: 28rpx;
  padding: 32rpx;
}
/* 头像：视觉层固定圆形，透明 button 覆盖层提供 chooseAvatar 能力 */
.avatar-wrap {
  position: relative;
  width: 116rpx;
  height: 116rpx;
  flex: none;
}
.avatar-img {
  width: 116rpx;
  height: 116rpx;
  display: block;
  border-radius: 50%;
}
.avatar-holder {
  width: 116rpx;
  height: 116rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--primary), #2AA886);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  overflow: hidden;
}
.avatar-icon { width: 40rpx; height: 40rpx; }
.avatar-tip { font-size: 16rpx; color: rgba(255, 255, 255, 0.9); text-align: center; }

/* 透明按钮覆盖层：铺满父容器，不携带任何默认按钮视觉 */
.overlay-btn {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  opacity: 0;
  padding: 0;
  margin: 0;
  border: none;
  border-radius: 0;
  background: transparent;
  line-height: 1;
  font-size: 0;
}
.overlay-btn::after { border: none; }

.profile-info { flex: 1; min-width: 0; }
.nick-input {
  font-size: 32rpx;
  font-weight: 700;
  height: 56rpx;
  line-height: 56rpx;
}
.nick-ph {
  color: #B9B6AA;
  font-weight: 500;
  font-size: 28rpx;
}
/* 资料锁定后：昵称纯文本展示（视觉与 nick-input 一致，但不可编辑） */
.nick-text {
  font-size: 32rpx;
  font-weight: 700;
  height: 56rpx;
  line-height: 56rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.profile-sub {
  margin-top: 8rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}
.sub-text {
  font-size: 23rpx;
  color: var(--sub);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.cloud-tag {
  flex: none;
  font-size: 18rpx;
  color: var(--primary);
  background: var(--primary-weak);
  border-radius: 14rpx;
  padding: 2rpx 12rpx;
}

/* 未同步到云端：中性灰，陈述事实而非报错 */
.cloud-tag.tag-local {
  color: #8C8776;
  background: #F1EFE7;
}

/* 有字段降级到底仍超限（v1.1.0）：琥珀色。既不是成功（主色）也不是彻底没同步（灰），
   如实落在中间态——文案「部分数据未同步」，见 mine.js 的 _syncNote */
.cloud-tag.tag-warn {
  color: #8A6A17;
  background: #FAF3E2;
}

/* 同步降级说明行（v1.1.0）：同 tag-warn 的琥珀语气，陈述事实而非报错。
   只在真有情况时渲染（mine.wxml 的 wx:if），平时不占高度、手机端资料卡高度零变化 */
.sync-note {
  margin-top: 8rpx;
  font-size: 21rpx;
  line-height: 1.5;
  color: #8A6A17;
}

/* ===== 模板列表（重排版：view 替代 button，避免默认按钮样式干扰） ===== */
.tpl-card { padding: 8rpx 28rpx; }
.tpl-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.tpl-item:last-child { border-bottom: none; }
.ticon {
  width: 60rpx;
  height: 84rpx;
  border: 1rpx solid var(--line);
  border-radius: 10rpx;
  background: #FDFCFA;
  flex: none;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}
.ticon image { width: 100%; height: 100%; display: block; }
.tinfo {
  flex: 1;
  min-width: 0;
}
.tname {
  font-size: 27rpx;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.tmeta { font-size: 22rpx; color: var(--sub); margin-top: 4rpx; }
/* 两个次操作按钮共用外形；描边统一 3rpx、box-sizing 保证宽度与高度对齐 */
.tapply,
.tdel {
  flex: none;
  font-size: 23rpx;
  border-radius: 28rpx;
  padding: 0 24rpx;
  line-height: 52rpx;
  text-align: center;
  box-sizing: border-box;
  border: 3rpx solid transparent;
  background: #fff;
}
.tapply {
  color: var(--primary);
  border-color: var(--primary);
  font-weight: 600;
}
/* 删除属危险操作：红字红描边（--danger），与「套用」的绿色主操作形成对称的主次区分 */
.tdel {
  color: var(--danger);
  border-color: var(--danger);
}
.tbtn-hover { opacity: 0.7; }

/* ===== 通用菜单（所有行统一 view 布局；contact/feedback 由透明覆盖层提供） ===== */
.menu-card { padding: 4rpx 28rpx; }
.menu-item {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 20rpx;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--line);
  font-size: 29rpx;
  color: var(--ink);
  background: #fff;
  width: 100%;
  box-sizing: border-box;
  text-align: left;
  border-radius: 0;
  line-height: inherit;
}
.menu-item:last-child { border-bottom: none; }
.menu-item::after { border: none; }
.menu-item .mtext { flex: 1; }
.micon {
  width: 40rpx;
  height: 40rpx;
  flex: none;
}
.mval { font-size: 23rpx; color: var(--sub); flex: none; }
/* 「关于」入口的 NEW 徽标：有未读版本更新时显示（判据见 mine.js 的 _ensureVersionBaseline）。
   用主色实心块而非浅色——它出现在列表行里、周围没有别的色块争夺注意力，
   要的是「一眼扫到」，与「关于」页内的 .vnew（浅底、与版本号并列）刻意区分。 */
.mnew {
  font-size: 18rpx;
  font-weight: 700;
  color: #fff;
  background: var(--primary);
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
  flex: none;
}
.marr { width: 28rpx; height: 28rpx; flex: none; }
.item-hover { background: #FAFAF7; }

/* 危险操作行（清除我的资料）：只让文字与图标走危险色，不整行铺红底——
   它属于低频的不可恢复操作，不该在视觉上比「关于」更抢眼（防误触） */
.menu-item.danger .mtext { color: var(--danger); }

/* ==================== 响应式：大屏（v2.0）====================
   依据见 app.wxss 顶部（三档口径 / 「大屏 px = 小屏 rpx ÷ 2」换算律 /
   媒体查询必须放文件末尾）。手机竖屏永不命中 → 手机端零变化。 */
@media (min-width: 600px) {
  .page { padding: 12px 16px 0; }

  .profile-card { gap: 14px; padding: 16px; }
  .avatar-wrap,
  .avatar-img,
  .avatar-holder { width: 58px; height: 58px; }
  .avatar-holder { gap: 2px; }
  .avatar-icon { width: 20px; height: 20px; }
  .avatar-tip { font-size: 8px; }

  .nick-input,
  .nick-text { font-size: 16px; height: 28px; line-height: 28px; }
  .nick-ph { font-size: 14px; }
  .profile-sub { margin-top: 4px; gap: 6px; }
  .sub-text { font-size: 11.5px; }
  .cloud-tag { font-size: 9px; border-radius: 7px; padding: 1px 6px; }
  .sync-note { margin-top: 4px; font-size: 10.5px; }

  .tpl-card { padding: 4px 14px; }
  .tpl-item { gap: 10px; padding: 12px 0; }
  .ticon { width: 30px; height: 42px; border-radius: 5px; }
  .tname { font-size: 13.5px; }
  .tmeta { font-size: 11px; margin-top: 2px; }
  .tapply,
  .tdel {
    font-size: 11.5px;
    border-radius: 14px;
    padding: 0 12px;
    line-height: 26px;
    border-width: 2px;
  }

  .menu-card { padding: 2px 14px; }
  .menu-item { gap: 10px; padding: 14px 0; font-size: 14.5px; }
  .micon { width: 20px; height: 20px; }
  .mval { font-size: 11.5px; }
  .mnew { font-size: 9px; border-radius: 4px; padding: 1px 5px; }
  .marr { width: 14px; height: 14px; }
}
